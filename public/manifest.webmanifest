{
  "id": "/",
  "name": "ContribuTrack",
  "short_name": "ContribuTrack",
  "description": "Multimodal team contribution analytics, fair grading, live sessions, and tamper-evident credentials.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#09090B",
  "theme_color": "#09090B",
  "orientation": "any",
  "categories": ["productivity", "education", "business"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Open your team fairness and contribution dashboard",
      "url": "/dashboard",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Live Sessions",
      "short_name": "Sessions",
      "description": "Review or record live team sessions",
      "url": "/sessions",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Join Workspace",
      "short_name": "Join",
      "description": "Join a project team or session via invite code",
      "url": "/join",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
