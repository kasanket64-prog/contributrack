# Optional: connect to a real Supabase project.
# When omitted, ContribuTrack automatically runs in Local Demo Mode
# (persisted in localStorage + IndexedDB with rule-based scoring).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge Function secrets (set via `supabase secrets set ...`, NOT exposed to frontend).
# Any ONE of the following unlocks LLM-based scoring; otherwise rule-based fallback is used:
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=        # Free tier via Google AI Studio
# GROQ_API_KEY=          # Free tier via Groq
